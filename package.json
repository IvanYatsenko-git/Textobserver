{
  "name": "textobserver",
  "version": "0.2.0",
  "description": "Desktop document editor with local hybrid search using BGE-M3, BM25, and ChromaDB",
  "main": "src/main/main.js",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --debug",
    "build:renderer": "esbuild src/renderer/renderer.js --bundle --outfile=src/renderer/renderer.bundle.js --external:electron",
    "build": "npm run build:renderer && electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.19.0"
  },
  "build": {
    "appId": "com.textobserver.app",
    "productName": "TextObserver",
    "asarUnpack": [
      "python_backend/**/*.py"
    ],
    "files": [
      "src/**/*",
      "python_backend/**/*",
      "assets/**/*",
      "!src/renderer/renderer.js",
      "package.json"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.2.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.43.4",
    "@google/generative-ai": "^0.24.1",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.3.289"
  }
}
